# rviz2 for an arbitrary ROS 2 distro, so the local side can match whatever the
# remote container runs. Cross-distro ROS 2 does not interoperate, and the host
# OS usually cannot install the needed distro natively -- this bridges that.
ARG ROS_DISTRO=humble
FROM osrf/ros:${ROS_DISTRO}-desktop

ARG ROS_DISTRO
ARG RMW=rmw_zenoh_cpp

# The RMW package name follows from the implementation name, except Fast DDS,
# which ships as ros-<distro>-rmw-fastrtps-cpp and is already in -desktop.
RUN set -eux; \
    pkg=""; \
    case "$RMW" in \
      rmw_zenoh_cpp)      pkg="ros-${ROS_DISTRO}-rmw-zenoh-cpp" ;; \
      rmw_cyclonedds_cpp) pkg="ros-${ROS_DISTRO}-rmw-cyclonedds-cpp" ;; \
      rmw_fastrtps_cpp)   pkg="" ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends xauth mesa-utils ${pkg}; \
    rm -rf /var/lib/apt/lists/*

# Message packages for your robot's custom types. Without them "ros2 topic echo"
# and rviz2 can list a topic but cannot deserialise it.
ARG EXTRA_APT=""
RUN set -eux; \
    if [ -n "$EXTRA_APT" ]; then \
      apt-get update; \
      apt-get install -y --no-install-recommends $EXTRA_APT; \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Interface-only mirrors of message packages that exist only on the robot,
# produced by "rrv msgs sync". Empty unless you have run it.
COPY msgs/ /tmp/msgs_ws/src/
ARG ROS_DISTRO
# No -u here: ROS's setup.sh reads AMENT_TRACE_SETUP_FILES without a default,
# so "set -u" makes sourcing it abort.
RUN set -ex; \
    if [ -n "$(find /tmp/msgs_ws/src -mindepth 1 -maxdepth 1 -type d 2>/dev/null)" ]; then \
      apt-get update; \
      apt-get install -y --no-install-recommends python3-colcon-common-extensions; \
      . /opt/ros/${ROS_DISTRO}/setup.sh; \
      cd /tmp/msgs_ws; \
      colcon build --merge-install --install-base /opt/rrv_msgs; \
      rm -rf /var/lib/apt/lists/*; \
    fi; \
    rm -rf /tmp/msgs_ws

ENV RMW_IMPLEMENTATION=${RMW}
