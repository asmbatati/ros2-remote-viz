# rrv profile. Copy to config/<name>.env (rrv init does this) and edit.
PROFILE_NAME=default

# Required: how to ssh to the machine running the ROS container.
# Key auth must work: ssh-copy-id <user>@<host>   (run in a real terminal)
REMOTE_SSH=nvidia@192.168.1.118

# Container running ROS 2 there. 'auto' picks it when exactly one is running.
REMOTE_CONTAINER=auto

# 'auto' picks an RMW both sides have, preferring what the remote already uses.
# Or pin one: rmw_zenoh_cpp | rmw_cyclonedds_cpp | rmw_fastrtps_cpp
RMW=auto

# Must match on both sides for the DDS implementations.
ROS_DOMAIN_ID=0

# Address the local side dials for ROS traffic. Defaults to the SSH host.
# Set this when data should take a different route than SSH -- e.g. a ZeroTier
# or Tailscale address while you ssh over the LAN.
#TRANSPORT_HOST=10.147.19.118
