#!/usr/bin/env bash
# rrv - run rviz2 on this machine against ROS 2 running in a remote container.
#
# Detects the ROS distro and RMW on both sides, picks a compatible pairing, and
# starts whatever that pairing needs. See README.md.
set -eo pipefail

# Resolve symlinks: when installed as ~/.local/bin/rrv this must still point at
# the checkout, not at ~/.local.
_rrv_self="${BASH_SOURCE[0]}"
while [ -L "$_rrv_self" ]; do
  _rrv_link="$(readlink "$_rrv_self")"
  case "$_rrv_link" in
    /*) _rrv_self="$_rrv_link" ;;
    *)  _rrv_self="$(dirname "$_rrv_self")/$_rrv_link" ;;
  esac
done
RRV_ROOT="$(cd "$(dirname "$_rrv_self")/.." && pwd)"
export RRV_ROOT
. "$RRV_ROOT/lib/common.sh"
. "$RRV_ROOT/lib/detect.sh"
. "$RRV_ROOT/lib/plan.sh"
. "$RRV_ROOT/lib/rmw/load.sh"

usage() {
  cat <<USAGE
${C_B}rrv${C_RST} - remote ROS 2 visualisation

  rrv install               symlink rrv onto your PATH so it runs from anywhere
  rrv init [profile]        create config/<profile>.env from the template
  rrv detect [profile]      probe both machines and cache the result
  rrv plan [profile]        show what detect chose, and why
  rrv build [profile]       build the local rviz2 image (docker mode only)
  rrv up [profile]          start routers/daemons the chosen RMW needs
  rrv rviz [config]         launch rviz2 here (starts 'up' first if needed)
  rrv configs               list the .rviz layouts in rviz/
  rrv shell                 interactive shell where plain 'ros2 ...' hits the remote
  rrv run [profile] CMD...  run any ros2 command here, wired to the remote graph
  rrv shim install|remove   make bare 'ros2' reach the remote in every shell
  rrv remote [profile] CMD  run a command in the remote container with matching env
  rrv x11 [profile]         fallback: rviz2 inside the remote container, shown here
  rrv doctor [profile]      connectivity and configuration checks
  rrv down [profile]        stop everything rrv started
  rrv env [profile]         print the env a node needs, for sourcing

Add -p NAME to use a different profile (config/<NAME>.env); default is 'default'.

Drop .rviz layouts into rviz/ and open one by name:
  rrv rviz nav            opens rviz/nav.rviz
  rrv rviz                opens rviz/default.rviz if present
Layouts are mounted read-write, so saving inside rviz2 writes back to rviz/.
USAGE
}

# ---------------------------------------------------------------------------
need_detect() { load_profile "$1"; cache_load; rmw_load; }

cmd_init() {
  # Split: within a single `local`, every argument is expanded before any
  # assignment takes effect, so "$p" here would still be the old (empty) value.
  local p="${1:-default}"
  local f="$RRV_ROOT/config/$p.env"
  [ -e "$f" ] && die "$f already exists"
  mkdir -p "$RRV_ROOT/config"
  sed "s/^PROFILE_NAME=.*/PROFILE_NAME=$p/" "$RRV_ROOT/config/default.env.template" > "$f"
  ok "created $f"
  info "Edit REMOTE_SSH in it, then run: rrv detect $p"
}

cmd_detect() {
  load_profile "${1:-default}"
  detect_local
  detect_remote
  plan_build
  L_TRANSPORT_SELF="$(detect_self_ip)"
  echo
  plan_show
  cache_save \
    "L_OS=$(printf '%q' "$L_OS")" "L_ARCH=$L_ARCH" \
    "L_DISTROS=$(printf '%q' "$L_DISTROS")" "L_RMWS=$(printf '%q' "$L_RMWS")" \
    "L_DOCKER=$L_DOCKER" "L_NVIDIA_RT=$L_NVIDIA_RT" \
    "L_GPU=$(printf '%q' "$L_GPU")" "L_TRANSPORT_SELF=$L_TRANSPORT_SELF" \
    "R_OS=$(printf '%q' "$R_OS")" "R_ARCH=$R_ARCH" "R_IPV6=$R_IPV6" \
    "R_CONTAINER=$(printf '%q' "$R_CONTAINER")" "R_IMAGE=$(printf '%q' "$R_IMAGE")" \
    "R_NETMODE=$R_NETMODE" "R_DISTRO=$R_DISTRO" \
    "R_RMWS=$(printf '%q' "$R_RMWS")" "R_RMW_CUR=$(printf '%q' "$R_RMW_CUR")" \
    "R_HAS_RVIZ=$R_HAS_RVIZ" \
    "P_RMW=$P_RMW" "P_MODE=$P_MODE" "P_IMAGE=$P_IMAGE" \
    "P_NEEDS_ROUTER=$P_NEEDS_ROUTER" "P_XHOST=$P_XHOST" \
    "P_REASON=$(printf '%q' "$P_REASON")"
  echo; ok "cached -> $(cache_file)"
}

cmd_plan() { need_detect "${1:-default}"; plan_show; }

cmd_build() {
  need_detect "${1:-default}"
  [ "$P_MODE" = docker ] || { ok "native mode - nothing to build"; return 0; }
  step "Building $P_IMAGE (ROS $R_DISTRO)"
  [ -n "$EXTRA_APT" ] && dim "  extra packages: $EXTRA_APT"
  docker build --build-arg ROS_DISTRO="$R_DISTRO" --build-arg RMW="$P_RMW" \
    --build-arg EXTRA_APT="$EXTRA_APT" \
    -t "$P_IMAGE" -f "$RRV_ROOT/docker/Dockerfile.rviz" "$RRV_ROOT/docker"
  ok "built $P_IMAGE"
}

# --- argument handling ------------------------------------------------------
# Options are taken from the front of the argument list only, so everything
# after them is passed through untouched (rrv run needs that).
RRV_P=""            # profile from -p, empty means 'default'
RRV_ARGS=()
parse_opts() {
  RRV_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -p|--profile) [ $# -ge 2 ] || die "-p needs a profile name"; RRV_P="$2"; shift 2 ;;
      -p=*|--profile=*) RRV_P="${1#*=}"; shift ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  RRV_ARGS=("$@")
}
# Commands taking no positional args accept a bare profile name for convenience.
profile_or_arg() { if [ -n "$RRV_P" ]; then echo "$RRV_P"; else echo "${1:-default}"; fi; }
profile_only()   { if [ -n "$RRV_P" ]; then echo "$RRV_P"; else echo "default"; fi; }

# --- rviz layouts -----------------------------------------------------------
RVIZ_DIR() { echo "$RRV_ROOT/rviz"; }

list_configs() {
  local d; d="$(RVIZ_DIR)"
  [ -d "$d" ] || return 0
  find "$d" -maxdepth 1 -name '*.rviz' -printf '%f\n' 2>/dev/null | sort
}

# Accepts a bare name, a name with .rviz, or a path. Prints the absolute path,
# or nothing when no layout was asked for and there is no default.
resolve_config() {
  local name="$1" d; d="$(RVIZ_DIR)"
  if [ -z "$name" ]; then
    [ -f "$d/default.rviz" ] && readlink -f "$d/default.rviz"
    return 0
  fi
  local c
  for c in "$name" "$d/$name" "$d/$name.rviz"; do
    [ -f "$c" ] && { readlink -f "$c"; return 0; }
  done
  local avail; avail="$(list_configs)"
  die "no rviz layout '$name'.
Available in $(RVIZ_DIR):
${avail:-  (none - drop a .rviz file there)}"
}

cmd_configs() {
  local d; d="$(RVIZ_DIR)"
  step "Layouts in $d"
  local l; l="$(list_configs)"
  if [ -z "$l" ]; then
    dim "  (none yet - drop a .rviz file in $d)"
  else
    printf '%s\n' "$l" | sed 's/\.rviz$//' | sed 's/^/  /'
    echo; dim "  open one with: rrv rviz <name>"
  fi
}

# --- install ----------------------------------------------------------------
cmd_install() {
  local target="${1:-$HOME/.local/bin}"
  mkdir -p "$target"
  local link="$target/rrv"
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    die "$link exists and is not a symlink - move it aside first"
  fi
  ln -sfn "$RRV_ROOT/bin/rrv" "$link"
  ok "linked $link -> $RRV_ROOT/bin/rrv"
  case ":$PATH:" in
    *":$target:"*) ok "$target is on your PATH - run 'rrv' from anywhere" ;;
    *) warn "$target is not on your PATH. Add to ~/.bashrc:
     export PATH=\"$target:\$PATH\"" ;;
  esac
}

# --- X11 plumbing for local GUI containers ---------------------------------
setup_xauth() {
  RRV_XAUTH=/tmp/.rrv.xauth
  : > "$RRV_XAUTH"
  # Wildcard the address family so the cookie matches inside the container,
  # whose hostname differs from the host's.
  xauth nlist "$DISPLAY" 2>/dev/null | sed -e 's/^..../ffff/' \
    | xauth -f "$RRV_XAUTH" nmerge - 2>/dev/null || true
  chmod 644 "$RRV_XAUTH"
}
# Re-quote argv into a single shell-safe string. "$*" would flatten quoting and
# break arguments containing spaces, e.g. ros2 topic pub ... "data: hello world".
argv_str() { local a out=""; for a in "$@"; do out+=" $(printf '%q' "$a")"; done; printf '%s' "$out"; }

# Docker args are built as arrays. Splicing them through an unquoted $(...)
# would need %q escaping, whose backslashes survive into the value itself and
# corrupt settings like ZENOH_CONFIG_OVERRIDE='["tcp/0.0.0.0:7447"]'.
build_gui_args() {
  RRV_GUIARGS=(--network host
    -e "DISPLAY=$DISPLAY" -e "XAUTHORITY=$RRV_XAUTH"
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw -v "$RRV_XAUTH:$RRV_XAUTH:rw")
  if [ "$L_NVIDIA_RT" = yes ]; then
    RRV_GUIARGS+=(--runtime nvidia -e NVIDIA_VISIBLE_DEVICES=all
                  -e NVIDIA_DRIVER_CAPABILITIES=all)
  fi
}
# Files the RMW needs visible inside the container (e.g. a DDS XML profile).
build_mount_args() {
  RRV_MOUNTARGS=()
  local f
  while IFS= read -r f; do
    [ -n "$f" ] && [ -e "$f" ] && RRV_MOUNTARGS+=(-v "$f:$f:ro")
  done < <(rmw_local_mounts)
}
# Sourcing prefix for commands run in the container: base ROS, then an optional
# overlay workspace holding locally-built message packages.
ros_setup() {
  local c="source /opt/ros/$R_DISTRO/setup.bash"
  [ -n "$OVERLAY_WS" ] && c="$c && [ -f '$OVERLAY_WS/install/setup.bash' ] && source '$OVERLAY_WS/install/setup.bash'; true"
  echo "$c"
}
# Mount for that overlay, if configured.
overlay_mount() {
  RRV_OVERLAY=()
  if [ -n "$OVERLAY_WS" ] && [ -d "$OVERLAY_WS" ]; then
    RRV_OVERLAY=(-v "$OVERLAY_WS:$OVERLAY_WS:ro")
  fi
}
# -t only when we actually have a terminal, so piping rrv run still works.
# Must not end on a failed test: under `set -e` a non-zero return from this
# function would abort the whole script when there is no terminal.
tty_flags() {
  RRV_TTY=()
  if [ -t 0 ] && [ -t 1 ]; then RRV_TTY=(-t); fi
}
# $1 = name of a function printing KEY=VALUE lines
build_env_args() {
  RRV_ENVARGS=()
  local l
  while IFS= read -r l; do [ -n "$l" ] && RRV_ENVARGS+=(-e "$l"); done < <("$1")
}
env_exports() { while IFS= read -r l; do [ -n "$l" ] && printf 'export %q\n' "$l"; done; }

cmd_up() {
  need_detect "${1:-default}"
  rmw_remote_prepare
  if [ "$P_NEEDS_ROUTER" != yes ]; then
    ok "$P_RMW needs no daemon - peers are configured directly"
    return 0
  fi
  if rsh "docker exec $R_CONTAINER pgrep -f rmw_zenohd >/dev/null 2>&1"; then
    ok "remote router already running in $R_CONTAINER"
  else
    step "Starting remote router in $R_CONTAINER"
    rsh "docker exec -d $(rmw_remote_daemon_env) $R_CONTAINER bash -lc $(printf '%q' "$(rmw_remote_daemon_cmd)")"
    sleep 4
    rsh "docker exec $R_CONTAINER pgrep -f rmw_zenohd >/dev/null 2>&1" \
      && ok "remote router up" || die "remote router failed to start"
  fi
  if docker ps --format '{{.Names}}' | grep -qx rrv-router; then
    ok "local router already running"
  else
    step "Starting local router"
    build_env_args rmw_local_daemon_env
    docker run -d --rm --name rrv-router --network host \
      "${RRV_ENVARGS[@]}" "$P_IMAGE" \
      bash -lc "$(rmw_local_daemon_cmd)" >/dev/null
    sleep 4
    docker ps --format '{{.Names}}' | grep -qx rrv-router \
      && ok "local router up" || die "local router failed - check: docker logs rrv-router"
  fi
}

cmd_rviz() {
  local p="$1"; shift
  local want=""
  if [ $# -gt 0 ]; then want="$1"; shift; fi
  # Validate inputs before starting anything, so a typo does not leave routers
  # running behind a failed launch.
  [ -n "${DISPLAY:-}" ] || die "DISPLAY is unset - no X display to draw on"
  local cfg; cfg="$(resolve_config "$want")"
  local -a cfgargs=()
  [ -n "$cfg" ] && cfgargs=(-d "$cfg")

  cmd_up "$p"
  need_detect "$p"
  [ -n "$cfg" ] && info "  layout        $cfg"

  step "Launching rviz2 ($P_MODE)"
  if [ "$P_MODE" = native ]; then
    # shellcheck disable=SC1090
    . "/opt/ros/$R_DISTRO/setup.bash"
    eval "$(rmw_local_node_env | env_exports)"
    exec rviz2 "${cfgargs[@]}" "$@"
  fi

  setup_xauth
  build_gui_args
  build_env_args rmw_local_node_env
  build_mount_args
  # Mount the layout directory read-write at the same path, so "Save Config"
  # inside rviz2 lands back in the repo rather than vanishing with the container.
  overlay_mount
  local -a rvizmount=()
  [ -d "$(RVIZ_DIR)" ] && rvizmount=(-v "$(RVIZ_DIR):$(RVIZ_DIR):rw")
  # A layout given as a path outside rviz/ needs its own mount.
  if [ -n "$cfg" ]; then
    case "$cfg" in
      "$(RVIZ_DIR)"/*) ;;
      *) rvizmount+=(-v "$cfg:$cfg:ro") ;;
    esac
  fi

  exec docker run --rm --name rrv-rviz "${RRV_GUIARGS[@]}" "${RRV_ENVARGS[@]}" \
    "${RRV_MOUNTARGS[@]}" "${rvizmount[@]}" "${RRV_OVERLAY[@]}" \
    "$P_IMAGE" bash -lc "$(ros_setup) && exec rviz2$(argv_str "${cfgargs[@]}" "$@")"
}

cmd_run() {
  local p="$1"; shift
  need_detect "$p"
  [ $# -gt 0 ] || die "usage: rrv run [profile] <ros2 command...>"
  if [ "$P_MODE" = native ]; then
    # shellcheck disable=SC1090
    . "/opt/ros/$R_DISTRO/setup.bash"
    eval "$(rmw_local_node_env | env_exports)"
    exec "$@"
  fi
  build_env_args rmw_local_node_env
  build_mount_args
  tty_flags
  overlay_mount
  exec docker run --rm -i "${RRV_TTY[@]}" --network host "${RRV_ENVARGS[@]}" "${RRV_MOUNTARGS[@]}" "${RRV_OVERLAY[@]}" \
    "$P_IMAGE" bash -lc "$(ros_setup) && exec$(argv_str "$@")"
}

# Run a command inside the remote container with the RMW env this plan needs.
# Useful for smoke tests and for starting nodes that must match the local side.
cmd_remote() {
  local p="$1"; shift
  need_detect "$p"
  [ $# -gt 0 ] || die "usage: rrv remote [profile] <command...>"
  rmw_remote_prepare
  local envstr="" l
  while IFS= read -r l; do
    [ -n "$l" ] && envstr+=" -e $(printf '%q' "$l")"
  done < <(rmw_remote_node_env)
  rsh_in "docker exec -i$envstr $R_CONTAINER bash -lc $(printf '%q' "$(ros_setup) && exec$(argv_str "$@")")"
}

# An interactive shell already wired to the remote graph. Inside it, plain
# "ros2 topic list" sees the remote's topics with nothing shadowed globally.
cmd_shell() {
  local p="$1"; shift
  cmd_up "$p"
  need_detect "$p"
  if [ "$P_MODE" = native ]; then
    step "Shell with ROS $R_DISTRO + $P_RMW (exit to leave)"
    local rc; rc="$(mktemp)"
    { echo ". /opt/ros/$R_DISTRO/setup.bash"
      rmw_local_node_env | env_exports
      echo "PS1='(rrv:$RRV_PROFILE) \w\$ '"; } > "$rc"
    exec bash --rcfile "$rc" -i
  fi
  step "Shell in $P_IMAGE ($P_RMW -> $P_XHOST). Type 'exit' to leave."
  build_env_args rmw_local_node_env
  build_mount_args
  tty_flags
  local -a gui=()
  if [ -n "${DISPLAY:-}" ]; then setup_xauth; build_gui_args; gui=("${RRV_GUIARGS[@]}"); fi
  [ ${#gui[@]} -eq 0 ] && gui=(--network host)
  overlay_mount
  local -a rvizmount=()
  [ -d "$(RVIZ_DIR)" ] && rvizmount=(-v "$(RVIZ_DIR):$(RVIZ_DIR):rw")
  exec docker run --rm -i "${RRV_TTY[@]}" "${gui[@]}" "${RRV_ENVARGS[@]}" \
    "${RRV_MOUNTARGS[@]}" "${rvizmount[@]}" "${RRV_OVERLAY[@]}" \
    -e "PS1=(rrv:$RRV_PROFILE) \w\$ " \
    "$P_IMAGE" bash -lc "$(ros_setup) && exec bash --norc -i"
}

# Optional PATH shims so bare "ros2" reaches the remote graph.
SHIM_CMDS_DEFAULT="ros2"
cmd_shim() {
  local action="${1:-status}"; [ $# -gt 0 ] && shift
  local dir="${SHIM_DIR:-$HOME/.local/bin}"
  local profile="${RRV_P:-default}"
  case "$action" in
    install)
      local cmds="${*:-$SHIM_CMDS_DEFAULT}"
      mkdir -p "$dir"
      local c real
      for c in $cmds; do
        real="$(PATH="$(echo "$PATH" | tr ':' '\n' | grep -v "^$dir\$" | paste -sd:)" command -v "$c" || true)"
        cat > "$dir/$c" <<SHIM
#!/usr/bin/env bash
# Installed by 'rrv shim install'. Forwards $c to the remote ROS graph.
# Remove with: rrv shim remove
# Run the local $c instead with: RRV_SHIM_BYPASS=1 $c ...
if [ -n "\${RRV_SHIM_BYPASS:-}" ]; then
  exec ${real:-/usr/bin/env $c} "\$@"
fi
exec $RRV_ROOT/bin/rrv run -p $profile $c "\$@"
SHIM
        chmod +x "$dir/$c"
        ok "shim $dir/$c  ->  rrv run -p $profile $c"
        [ -n "$real" ] && dim "     bypass: RRV_SHIM_BYPASS=1 $c ...  (runs $real)" \
                       || warn "no local '$c' found; bypass will fail"
      done
      case ":$PATH:" in
        *":$dir:"*) ;;
        *) warn "$dir is not on your PATH - the shims will not be picked up" ;;
      esac
      warn "$(echo $cmds) now goes to the remote graph in every new shell.
     Undo with: rrv shim remove"
      ;;
    remove)
      local removed=0 f
      for f in "$dir"/*; do
        [ -f "$f" ] && grep -q "Installed by 'rrv shim install'" "$f" 2>/dev/null \
          && { rm -f "$f"; ok "removed $f"; removed=1; }
      done
      [ "$removed" = 1 ] || dim "  no rrv shims in $dir"
      ;;
    status)
      local found=0 f
      for f in "$dir"/*; do
        [ -f "$f" ] && grep -q "Installed by 'rrv shim install'" "$f" 2>/dev/null \
          && { info "  $f -> $(grep -o 'rrv run .*' "$f" | head -1)"; found=1; }
      done
      [ "$found" = 1 ] || dim "  no rrv shims installed in $dir"
      ;;
    *) die "usage: rrv shim [install [cmd...] | remove | status]" ;;
  esac
}

cmd_env() {
  need_detect "${1:-default}"
  rmw_local_node_env | env_exports
}

# --- fallback: remote rviz2, local display ---------------------------------
cmd_x11() {
  need_detect "${1:-default}"
  [ "$R_HAS_RVIZ" = yes ] || die "container '$R_CONTAINER' has no rviz2 installed"
  [ -n "${DISPLAY:-}" ] || die "DISPLAY is unset"
  local rport=6010
  local dnum="${DISPLAY#*:}"; dnum="${dnum%%.*}"
  local sock="/tmp/.X11-unix/X${dnum}"
  [ -S "$sock" ] || die "no X socket at $sock"

  # A reverse tunnel to our X socket, rather than ssh -X: where IPv6 is
  # disabled, sshd cannot bind its X11 listener and rejects forwarding with
  # "X11 forwarding request failed on channel 0". This needs no sudo and no
  # sshd_config change on the remote.
  local cookie; cookie=$(mktemp)
  xauth nlist "$DISPLAY" | sed -e 's/^..../ffff/' | xauth -f "$cookie" nmerge -
  scp -q -o ControlPath="$(ssh_ctl_path)" "$cookie" "$REMOTE_SSH:/tmp/.rrv.xauth"
  rm -f "$cookie"

  warn "rendering happens on the remote GPU and is streamed as X protocol;
     expect this to be slow for pointclouds. 'rrv rviz' is the fast path."
  step "Tunnelling $REMOTE_SSH:$rport -> $sock"
  exec ssh -o ControlPath="$(ssh_ctl_path)" -R "$rport:$sock" "$REMOTE_SSH" \
    "docker cp /tmp/.rrv.xauth $R_CONTAINER:/tmp/.rrv.xauth >/dev/null && \
     docker exec -e DISPLAY=localhost:10.0 -e XAUTHORITY=/tmp/.rrv.xauth \
       -e RMW_IMPLEMENTATION=$P_RMW $R_CONTAINER \
       bash -lc 'source /opt/ros/$R_DISTRO/setup.bash && exec rviz2'"
}

cmd_down() {
  need_detect "${1:-default}"
  step "Stopping"
  docker rm -f rrv-rviz rrv-router >/dev/null 2>&1 && ok "local containers stopped" || dim "  no local containers"
  if [ "$P_NEEDS_ROUTER" = yes ]; then
    rsh "docker exec $R_CONTAINER pkill -f rmw_zenohd" >/dev/null 2>&1 \
      && ok "remote router stopped" || dim "  no remote router"
  fi
}

cmd_doctor() {
  need_detect "${1:-default}"
  local fail=0
  step "Checks"
  rsh true 2>/dev/null && ok "ssh to $REMOTE_SSH" || { warn "ssh failed"; fail=1; }
  if [ "$R_NETMODE" = host ]; then ok "remote container uses host networking"
  else warn "remote container network is '$R_NETMODE' - ROS traffic cannot reach it"; fail=1; fi
  case " $R_RMWS " in *" $P_RMW "*) ok "remote provides $P_RMW" ;;
    *) warn "remote lacks $P_RMW"; fail=1 ;; esac
  if [ "$R_IPV6" = 1 ]; then ok "remote has IPv6 disabled (handled: routers bind 0.0.0.0)"; fi
  if [ "$P_NEEDS_ROUTER" = yes ]; then
    local port; port=$(rmw_ports)
    if timeout 5 bash -c "cat < /dev/null > /dev/tcp/$P_XHOST/$port" 2>/dev/null; then
      ok "$P_XHOST:$port reachable"
    else
      dim "  $P_XHOST:$port not open yet (expected until 'rrv up')"
    fi
  fi
  [ "$P_MODE" = docker ] && { docker image inspect "$P_IMAGE" >/dev/null 2>&1 \
    && ok "image $P_IMAGE present" || { warn "image $P_IMAGE missing - run: rrv build"; fail=1; }; }
  [ -n "${DISPLAY:-}" ] && ok "DISPLAY=$DISPLAY" || { warn "DISPLAY unset"; fail=1; }
  echo
  [ "$fail" = 0 ] && ok "all good" || die "some checks failed"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  install) parse_opts "$@"; cmd_install "${RRV_ARGS[@]}" ;;
  init)    parse_opts "$@"; cmd_init "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  detect)  parse_opts "$@"; cmd_detect "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  plan)    parse_opts "$@"; cmd_plan   "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  build)   parse_opts "$@"; cmd_build  "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  up)      parse_opts "$@"; cmd_up     "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  down)    parse_opts "$@"; cmd_down   "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  doctor)  parse_opts "$@"; cmd_doctor "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  env)     parse_opts "$@"; cmd_env    "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  x11)     parse_opts "$@"; cmd_x11    "$(profile_or_arg "${RRV_ARGS[0]:-}")" ;;
  configs) parse_opts "$@"; cmd_configs ;;
  shell)   parse_opts "$@"; cmd_shell   "$(profile_only)" ;;
  shim)    parse_opts "$@"; cmd_shim    "${RRV_ARGS[@]}" ;;
  rviz)    parse_opts "$@"; cmd_rviz   "$(profile_only)" "${RRV_ARGS[@]}" ;;
  run)     parse_opts "$@"; cmd_run    "$(profile_only)" "${RRV_ARGS[@]}" ;;
  remote)  parse_opts "$@"; cmd_remote "$(profile_only)" "${RRV_ARGS[@]}" ;;
  ''|-h|--help|help) usage ;;
  *) usage; die "unknown command: $cmd" ;;
esac
